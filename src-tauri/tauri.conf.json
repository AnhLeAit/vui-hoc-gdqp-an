{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vui Hoc GDQP-AN",
  "version": "1.0.2",
  "identifier": "vn.edu.hub.vuihocgdqp",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Vui học GDQP&AN",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "shortDescription": "Ôn tập và thi thử Giáo dục Quốc phòng & An ninh",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "languages": ["English", "Vietnamese"], "displayLanguageSelector": false }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
